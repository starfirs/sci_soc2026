# DeepSeek 的 Anthropic 兼容接口
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
ANTHROPIC_AUTH_TOKEN=sk-your-deepseek-key
DEEPSEEK_MODEL=deepseek-flash

# 可选：云端调用参数（默认 4096 tokens / 30 秒超时）
# DEEPSEEK_MAX_TOKENS=4096
# DEEPSEEK_TIMEOUT=30

# 可选：项目私有 OCR 引擎目录（默认 vendor/ocr_engines/{paddle,rapid}）
# LOCAL_OCR_PADDLE_DIR=D:/path/to/PaddleOCR-json
# LOCAL_OCR_RAPID_DIR=D:/path/to/RapidOCR-json

# 可选：Umi-OCR HTTP 服务（--ocr-backend umi）
# UMI_OCR_ENGINE=paddle
# UMI_OCR_URL=http://127.0.0.1:1224
# 双实例：Paddle 和 Rapid 各一个端口
# UMI_OCR_PADDLE_URL=http://127.0.0.1:1224
# UMI_OCR_RAPID_URL=http://127.0.0.1:1225
# Umi-OCR 根目录，用于核对 Paddle 的 enable_mkldnn
# UMI_OCR_HOME=D:/Umi-OCR_Paddle

# 可选：覆盖本地数据库位置（默认 data/memory.db）
# MEMORY_DB=data/memory.db
